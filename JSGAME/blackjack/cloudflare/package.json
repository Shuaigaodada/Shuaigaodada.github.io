{
  "name": "blackjack-cloudflare-backend",
  "private": true,
  "scripts": {
    "predev": "wrangler d1 migrations apply blackjack-users --local",
    "dev": "wrangler dev --ip 0.0.0.0",
    "db:migrate:local": "wrangler d1 migrations apply blackjack-users --local",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler types --check && tsc -p tsconfig.json && wrangler deploy --dry-run --outdir dist-check"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
