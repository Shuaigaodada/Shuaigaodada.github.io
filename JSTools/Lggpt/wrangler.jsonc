{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "laogao-gpt-api",
    "main": "worker/index.mjs",
    "compatibility_date": "2026-08-08",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "preview_urls": true,
    "assets": {
        "directory": ".",
        "run_worker_first": ["/api/*"]
    },
    "vars": {
        "OPENAI_MODEL": "gpt-5.6-luna",
        "ALLOWED_ORIGINS": "https://shuaigaodada.github.io,http://localhost:3000,http://127.0.0.1:3000"
    },
    "secrets": {
        "required": ["OPENAI_API_KEY"]
    },
    "ratelimits": [
        {
            "name": "API_RATE_LIMITER",
            "namespace_id": "9856669856",
            "simple": {
                "limit": 12,
                "period": 60
            }
        }
    ],
    "observability": {
        "enabled": true,
        "head_sampling_rate": 1
    }
}
